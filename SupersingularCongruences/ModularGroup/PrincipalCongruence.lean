    (45, [((2, 1, -1, 0), false), ((-1, 0, 0, -1), false), ((1, -1, 1, 0), false)]),
    (41, [])]]

theorem check_three : check 3 reps3 table3 = true := by decide

theorem check_four : check 4 reps4 table4 = true := by decide

end ModularGroup.CosetCertificate

/-- For `N ∈ {3, 4}`, `Γ(N)` is contained in the normal closure of `T^N`. -/
theorem CongruenceSubgroup.Gamma_le_normalClosure_T_pow (N : ℕ) (hN : N = 3 ∨ N = 4) :
    Gamma N ≤ Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)} := by
  rcases hN with rfl | rfl
  · exact ModularGroup.CosetCertificate.Gamma_le_of_check 3 _ _
      ModularGroup.CosetCertificate.check_three
  · exact ModularGroup.CosetCertificate.Gamma_le_of_check 4 _ _
      ModularGroup.CosetCertificate.check_four
