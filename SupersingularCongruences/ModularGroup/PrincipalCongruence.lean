/-!
# Generation of `Γ(3)` and `Γ(4)` by parabolic elements

For `N ∈ {3, 4}` the principal congruence subgroup `Γ(N)` is the normal closure of
`T^N = !![1, N; 0, 1]` in `SL(2, ℤ)`; in particular it is generated by parabolic elements
(conjugates of `T^{±N}`), as used in the proof of Proposition 4.5(a) of the manuscript.

## Proof

Write `H` for the normal closure of `T^N`. We exhibit an explicit list `R` of `|SL(2, ℤ/N)|`
matrices (24 for `N = 3`, 48 for `N = 4`), with `R[0] = 1` and no other entry congruent to `1`
modulo `N`, together with a certificate that the union of the cosets `r H` (`r ∈ R`) is
stable under left multiplication by `S, T, S⁻¹, T⁻¹`: for each `r ∈ R` and each such
generator `g` an index `r' ∈ R` and an explicit product `h` of conjugates of `T^{±N}` with
`g r = r' h`. The certificate is checked by `decide` on integer quadruples. Since `S` and `T`
generate `SL(2, ℤ)`, every element lies in some `r H`; for `γ ∈ Γ(N)` this forces
`r ≡ 1 (mod N)`, hence `r = 1` and `γ ∈ H`.
-/

public section

open CongruenceSubgroup Matrix MatrixGroups

namespace ModularGroup.CosetCertificate

/-- A `2 × 2` integer matrix `!![a, b; c, d]`, recorded as the quadruple `(a, b, c, d)`. -/
abbrev Quad := ℤ × ℤ × ℤ × ℤ

/-- Matrix multiplication on quadruples. -/
def Quad.mul : Quad → Quad → Quad
  | (a, b, c, d), (e, f, g, h) => (a * e + b * g, a * f + b * h, c * e + d * g, c * f + d * h)

/-- The adjugate of a quadruple. -/
def Quad.adj : Quad → Quad
  | (a, b, c, d) => (d, -b, -c, a)

/-- The determinant of a quadruple. -/
def Quad.det : Quad → ℤ
  | (a, b, c, d) => a * d - b * c

/-- Whether a quadruple is congruent to the identity modulo `N`. -/
def Quad.congOne (N : ℕ) : Quad → Bool
  | (a, b, c, d) => (a - 1) % (N : ℤ) == 0 && b % (N : ℤ) == 0 && c % (N : ℤ) == 0 &&
      (d - 1) % (N : ℤ) == 0

/-- The entries of an element of `SL(2, ℤ)` as a quadruple. -/
def toQuad (g : SL(2, ℤ)) : Quad := (g 0 0, g 0 1, g 1 0, g 1 1)

lemma toQuad_mul (g h : SL(2, ℤ)) : toQuad (g * h) = (toQuad g).mul (toQuad h) := by
  simp [toQuad, Quad.mul, Matrix.mul_apply, Fin.sum_univ_two]

lemma toQuad_inv (g : SL(2, ℤ)) : toQuad g⁻¹ = (toQuad g).adj := by
  simp [toQuad, Quad.adj, SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two]

lemma toQuad_one : toQuad 1 = (1, 0, 0, 1) := by
  simp [toQuad]

lemma toQuad_injective : Function.Injective toQuad := by
  intro g h hgh
  simp only [toQuad, Prod.mk.injEq] at hgh
  obtain ⟨h1, h2, h3, h4⟩ := hgh
  ext i j
  fin_cases i <;> fin_cases j <;> assumption

lemma exists_toQuad_eq {q : Quad} (hq : q.det = 1) : ∃ g : SL(2, ℤ), toQuad g = q := by
  obtain ⟨a, b, c, d⟩ := q
  refine ⟨⟨!![a, b; c, d], ?_⟩, ?_⟩
  · simpa [Matrix.det_fin_two, Quad.det] using hq
  · simp [toQuad]

lemma toQuad_T_zpow (n : ℤ) : toQuad (ModularGroup.T ^ n) = (1, n, 0, 1) := by
  simp [toQuad, ModularGroup.coe_T_zpow]

lemma congOne_of_mem_Gamma {N : ℕ} {g : SL(2, ℤ)} (hg : g ∈ Gamma N) :
    (toQuad g).congOne N = true := by
  rw [Gamma_mem] at hg
  obtain ⟨h1, h2, h3, h4⟩ := hg
  have e1 : (((g 0 0 - 1 : ℤ)) : ZMod N) = 0 := by push_cast; rw [h1]; ring
  have e4 : (((g 1 1 - 1 : ℤ)) : ZMod N) = 0 := by push_cast; rw [h4]; ring
  rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at e1 e4 h2 h3
  simp [toQuad, Quad.congOne, Int.emod_eq_zero_of_dvd, e1, e4, h2, h3]

/-- The generators `S, T, S⁻¹, T⁻¹` of `SL(2, ℤ)`, indexed by `0, 1, 2, 3`. -/
def gen : ℕ → SL(2, ℤ)
  | 0 => ModularGroup.S
  | 1 => ModularGroup.T
  | 2 => ModularGroup.S⁻¹
  | _ => ModularGroup.T⁻¹

/-- The quadruples of the generators `gen`. -/
def genQuad : ℕ → Quad
  | 0 => (0, -1, 1, 0)
  | 1 => (1, 1, 0, 1)
  | 2 => (0, 1, -1, 0)
  | _ => (1, -1, 0, 1)

lemma toQuad_gen (k : ℕ) : toQuad (gen k) = genQuad k := by
  match k with
  | 0 => simp [toQuad, gen, genQuad, ModularGroup.coe_S]
  | 1 => simp [toQuad, gen, genQuad, ModularGroup.coe_T]
  | 2 => simp [toQuad_inv, gen, genQuad]; simp [toQuad, Quad.adj, ModularGroup.coe_S]
  | k + 3 => simp [toQuad, gen, genQuad]

/-- The quadruple of `c * T ^ (± N) * c⁻¹`, the sign being `+` for `true`. -/
def conjQuad (N : ℕ) (x : Quad × Bool) : Quad :=
  (x.1.mul (1, if x.2 then (N : ℤ) else -(N : ℤ), 0, 1)).mul x.1.adj

/-- The quadruple of the product of the conjugates `conjQuad N x` over a list. -/
def certQuad (N : ℕ) : List (Quad × Bool) → Quad
  | [] => (1, 0, 0, 1)
  | x :: l => (conjQuad N x).mul (certQuad N l)

lemma exists_mem_certQuad (N : ℕ) (l : List (Quad × Bool))
    (hl : ∀ x ∈ l, x.1.det = 1) :
    ∃ h ∈ Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)}, toQuad h = certQuad N l := by
  induction l with
  | nil => exact ⟨1, Subgroup.one_mem _, toQuad_one⟩
  | cons x l ih =>
    rw [List.forall_mem_cons] at hl
    obtain ⟨h, hh, hq⟩ := ih hl.2
    obtain ⟨c, hc⟩ := exists_toQuad_eq hl.1
    have hT : ModularGroup.T ^ (if x.2 then (N : ℤ) else -(N : ℤ)) ∈
        Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)} := by
      have hmem : ModularGroup.T ^ (N : ℤ) ∈
          Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)} :=
        Subgroup.subset_normalClosure rfl
      split_ifs
      · exact hmem
      · rw [zpow_neg]; exact Subgroup.inv_mem _ hmem
    refine ⟨c * ModularGroup.T ^ (if x.2 then (N : ℤ) else -(N : ℤ)) * c⁻¹ * h,
      Subgroup.mul_mem _ ((Subgroup.normalClosure_normal).conj_mem _ hT c) hh, ?_⟩
    rw [toQuad_mul, toQuad_mul, toQuad_mul, toQuad_inv, toQuad_T_zpow, hc, hq]
    rfl

/-- The certificate check: `reps` starts with the identity, consists of determinant one
matrices of which only the first is congruent to `1` modulo `N`, and for each `i` and each
generator `k`, row `i` of `table` gives `(j, l)` with `gen k * reps[i] = reps[j] * certQuad l`. -/
def check (N : ℕ) (reps : List Quad) (table : List (List (ℕ × List (Quad × Bool)))) : Bool :=
  reps.getD 0 0 == (1, 0, 0, 1) &&
  (List.range reps.length).all fun i =>
    (reps.getD i 0).det == 1 && (i == 0 || !(reps.getD i 0).congOne N) &&
    (List.range 4).all fun k =>
      decide ((((table.getD i []).getD k (0, [])).1) < reps.length) &&
      (((table.getD i []).getD k (0, [])).2.all fun x => x.1.det == 1) &&
      (genQuad k).mul (reps.getD i 0) ==
        (reps.getD ((table.getD i []).getD k (0, [])).1 0).mul
          (certQuad N ((table.getD i []).getD k (0, [])).2)

theorem Gamma_le_of_check (N : ℕ) (reps : List Quad)
    (table : List (List (ℕ × List (Quad × Bool)))) (hc : check N reps table = true) :
    Gamma N ≤ Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)} := by
  set H := Subgroup.normalClosure {ModularGroup.T ^ (N : ℤ)}
  simp only [check, Bool.and_eq_true, beq_iff_eq, List.all_eq_true, List.mem_range,
    Bool.or_eq_true, Bool.not_eq_true', decide_eq_true_eq] at hc
  obtain ⟨h0, hc⟩ := hc
  let P : SL(2, ℤ) → Prop := fun x =>
    ∃ i < reps.length, ∃ g : SL(2, ℤ), toQuad g = reps.getD i 0 ∧ g⁻¹ * x ∈ H
  have step : ∀ k < 4, ∀ y, P y → P (gen k * y) := by
    rintro k hk y ⟨i, hi, g, hg, hy⟩
    obtain ⟨-, hrow⟩ := hc i hi
    obtain ⟨⟨hj, hl⟩, heq⟩ := hrow k hk
    set j := ((table.getD i []).getD k (0, [])).1
    obtain ⟨g', hg'⟩ := exists_toQuad_eq (hc j hj).1.1
    obtain ⟨h, hH, hh⟩ := exists_mem_certQuad N _ hl
    have hmul : gen k * g = g' * h :=
      toQuad_injective (by rw [toQuad_mul, toQuad_mul, toQuad_gen, hg, hg', hh, heq])
    refine ⟨j, hj, g', hg', ?_⟩
    have : g'⁻¹ * (gen k * y) = h * (g⁻¹ * y) := by
      rw [show h = g'⁻¹ * (gen k * g) by rw [hmul]; group]
      group
    rw [this]
    exact Subgroup.mul_mem _ hH hy
  have hall : ∀ x, P x := by
    intro x
    have hx : x ∈ Subgroup.closure {ModularGroup.S, ModularGroup.T} := by
      rw [SpecialLinearGroup.SL2Z_generators]; trivial
    induction hx using Subgroup.closure_induction_left with
    | one =>
      have hlen : 0 < reps.length := by
        rcases reps with _ | ⟨r, rs⟩
        · exact absurd h0 (by decide)
        · simp
      exact ⟨0, hlen, 1, by rw [toQuad_one, h0], by simp [H.one_mem]⟩
    | mul_left x hx y _ ih =>
      rcases hx with rfl | rfl
      · exact step 0 (by norm_num) y ih
      · exact step 1 (by norm_num) y ih
    | inv_mul_cancel x hx y _ ih =>
      rcases hx with rfl | rfl
      · exact step 2 (by norm_num) y ih
      · exact step 3 (by norm_num) y ih
  intro γ hγ
  obtain ⟨i, hi, g, hg, hγH⟩ := hall γ
  have hHle : H ≤ Gamma N := by
    have := Gamma_normal N
    refine Subgroup.normalClosure_le_normal ?_
    rintro _ rfl
    rw [SetLike.mem_coe, Gamma_mem, ModularGroup.coe_T_zpow]
    simp
  have hgΓ : g ∈ Gamma N := by
    have := Subgroup.mul_mem _ hγ (Subgroup.inv_mem _ (hHle hγH))
    simpa using this
  have hcong := congOne_of_mem_Gamma hgΓ
  rcases (hc i hi).1.2 with rfl | hne
  · have : g = 1 := toQuad_injective (by rw [hg, h0, toQuad_one])
    subst this
    simpa using hγH
  · rw [hg, hne] at hcong
    exact absurd hcong Bool.false_ne_true

