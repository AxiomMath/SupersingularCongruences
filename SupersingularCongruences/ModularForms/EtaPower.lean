/-! ### The functions -/

/-- The infinite product `∏_{n ≥ 1} (1 - xⁿ)`. -/
noncomputable def etaProd (x : ℂ) : ℂ := ∏' n : ℕ, (1 - x ^ (n + 1))

/-- The function `F_N(q) = q ∏_{n ≥ 1} (1 - q^{N n})^{24 / N}` on the unit disc;
`h_N = F_N(q^{1/N})`. -/
noncomputable def cuspProd (N : ℕ) (q : ℂ) : ℂ := q * etaProd (q ^ N) ^ (24 / N)

/-- The eta power `h_N = η^{24 / N}` as a function on `ℍ`. -/
noncomputable def etaPow (N : ℕ) (τ : ℍ) : ℂ := η τ ^ (24 / N)

lemma eta_eq_qParam_mul_etaProd (z : ℂ) : η z = 𝕢 24 z * etaProd (𝕢 1 z) := by
  rw [ModularForm.eta.eq_1]
  congr 1

lemma pos_of_mem {N : ℕ} (hN : N = 3 ∨ N = 4) : 0 < N := by
  rcases hN with rfl | rfl <;> norm_num

lemma mul_exponent {N : ℕ} (hN : N = 3 ∨ N = 4) : N * (24 / N) = 24 := by
  rcases hN with rfl | rfl <;> norm_num

lemma mul_weight {N : ℕ} (hN : N = 3 ∨ N = 4) : (N : ℤ) * ((12 / N : ℕ) : ℤ) = 12 := by
  rcases hN with rfl | rfl <;> norm_num

lemma qParam_pow_exponent {N : ℕ} (hN : N = 3 ∨ N = 4) (z : ℂ) :
    𝕢 24 z ^ (24 / N) = 𝕢 N z := by
  have hN0 : (N : ℂ) ≠ 0 := by exact_mod_cast (pos_of_mem hN).ne'
  have h24 : ((24 / N : ℕ) : ℂ) = 24 / N := by
    rw [eq_div_iff hN0, mul_comm]; exact_mod_cast mul_exponent hN
  simp only [Function.Periodic.qParam, ← Complex.exp_nat_mul, h24]
  congr 1
  push_cast
  field_simp

lemma qParam_pow_self {N : ℕ} (hN : 0 < N) (z : ℂ) : 𝕢 N z ^ N = 𝕢 1 z := by
  have hN0 : (N : ℂ) ≠ 0 := by exact_mod_cast hN.ne'
  simp only [Function.Periodic.qParam, ← Complex.exp_nat_mul]
  congr 1
  push_cast
  field_simp

lemma qParam_add_period {N : ℕ} (hN : 0 < N) (z : ℂ) : 𝕢 N (z + N) = 𝕢 N z := by
  have hN0 : (N : ℂ) ≠ 0 := by exact_mod_cast hN.ne'
  simp only [Function.Periodic.qParam]
  push_cast
  rw [show 2 * ↑Real.pi * Complex.I * (z + N) / N = 2 * ↑Real.pi * Complex.I * z / N +
    2 * ↑Real.pi * Complex.I by field_simp, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]

lemma etaPow_eq_cuspProd {N : ℕ} (hN : N = 3 ∨ N = 4) (τ : ℍ) :
    etaPow N τ = cuspProd N (𝕢 N τ) := by
  rw [etaPow, cuspProd, eta_eq_qParam_mul_etaProd, mul_pow, qParam_pow_exponent hN,
    qParam_pow_self (pos_of_mem hN)]

lemma etaPow_pow {N : ℕ} (hN : N = 3 ∨ N = 4) (τ : ℍ) :
    etaPow N τ ^ N = ModularForm.discriminant τ := by
  rw [etaPow, ← pow_mul, mul_comm, mul_exponent hN]
  rfl

lemma etaPow_ne_zero (N : ℕ) (τ : ℍ) : etaPow N τ ≠ 0 :=
  pow_ne_zero _ (eta_ne_zero τ.2)

lemma mdifferentiable_etaPow (N : ℕ) : MDiff (etaPow N) := by
  rw [UpperHalfPlane.mdifferentiable_iff]
  refine DifferentiableOn.congr (f := fun z ↦ η z ^ (24 / N)) ?_ ?_
  · intro z hz
    exact ((differentiableAt_eta_of_mem_upperHalfPlaneSet hz).pow _).differentiableWithinAt
  · intro z hz
    simp [etaPow, ofComplex_apply_of_im_pos hz]

lemma continuous_etaPow (N : ℕ) : Continuous (etaPow N) :=
  (mdifferentiable_etaPow N).continuous

lemma differentiableOn_etaProd : DifferentiableOn ℂ etaProd (Metric.ball 0 1) :=
  differentiableOn_tprod_one_sub_pow

lemma mapsTo_pow_ball {N : ℕ} (hN : 0 < N) :
    Set.MapsTo (fun q : ℂ ↦ q ^ N) (Metric.ball 0 1) (Metric.ball 0 1) := by
  intro q hq
  simp only [Metric.mem_ball, dist_zero_right, norm_pow] at hq ⊢
  exact pow_lt_one₀ (norm_nonneg _) hq hN.ne'

lemma differentiableOn_cuspProd {N : ℕ} (hN : 0 < N) :
    DifferentiableOn ℂ (cuspProd N) (Metric.ball 0 1) := by
  have h1 : DifferentiableOn ℂ (fun q : ℂ ↦ etaProd (q ^ N)) (Metric.ball 0 1) :=
    differentiableOn_etaProd.comp (differentiableOn_pow N) (mapsTo_pow_ball hN)
  exact differentiableOn_id.mul (h1.pow _)

lemma tendsto_etaPow {N : ℕ} (hN : N = 3 ∨ N = 4) :
    Tendsto (etaPow N) atImInfty (𝓝 0) := by
  have hc : ContinuousAt (cuspProd N) 0 :=
    ((differentiableOn_cuspProd (pos_of_mem hN)).differentiableAt
      (Metric.ball_mem_nhds 0 one_pos)).continuousAt
  have h0 : cuspProd N 0 = 0 := by simp [cuspProd]
  have := hc.tendsto.comp (qParam_tendsto_atImInfty (h := N) (by exact_mod_cast pos_of_mem hN))
  rw [h0] at this
  exact this.congr fun τ ↦ (etaPow_eq_cuspProd hN τ).symm

/-! ### Slash invariance -/

lemma discriminant_slash (γ : SL(2, ℤ)) :
    ModularForm.discriminant ∣[(12 : ℤ)] γ = ModularForm.discriminant := by
  have := SlashInvariantFormClass.slash_action_eq CuspForm.discriminant
    (Matrix.SpecialLinearGroup.mapGL ℝ γ) ⟨γ, rfl⟩
  rw [CuspForm.coe_discriminant] at this
  rw [ModularForm.SL_slash]
  exact this

lemma slash_pow_apply (f : ℍ → ℂ) (k : ℤ) (n : ℕ) (γ : SL(2, ℤ)) (τ : ℍ) :
    (f ∣[k] γ) τ ^ n = ((fun τ ↦ f τ ^ n) ∣[(n : ℤ) * k] γ) τ := by
  rw [ModularForm.SL_slash_apply, ModularForm.SL_slash_apply, mul_pow, ← zpow_natCast,
    ← zpow_natCast, ← zpow_mul]
  congr 2
  ring

/-- For `γ ∈ SL(2, ℤ)`, `h_N ∣[k_N] γ = ζ • h_N` for an `N`-th root of unity `ζ` (`g / g₀` is a
continuous function on `ℍ` with values in `μ_N`). -/
lemma exists_slash_eq_smul {N : ℕ} (hN : N = 3 ∨ N = 4) (γ : SL(2, ℤ)) :
    ∃ c : ℂ, c ^ N = 1 ∧ etaPow N ∣[((12 / N : ℕ) : ℤ)] γ = c • etaPow N := by
  set g := etaPow N ∣[((12 / N : ℕ) : ℤ)] γ
  have hgN : ∀ τ, g τ ^ N = ModularForm.discriminant τ := by
    intro τ
    rw [slash_pow_apply, mul_weight hN]
    have : (fun τ ↦ etaPow N τ ^ N) = ModularForm.discriminant := funext (etaPow_pow hN)
    rw [this, discriminant_slash]
  set r : ℍ → ℂ := fun τ ↦ g τ / etaPow N τ
  have hrN : ∀ τ, r τ ^ N = 1 := by
    intro τ
    simp only [r, div_pow, hgN, ← etaPow_pow hN]
    exact div_self (pow_ne_zero _ (etaPow_ne_zero N τ))
  have hgc : Continuous g := by
    have := (mdifferentiable_etaPow N).slash ((12 / N : ℕ) : ℤ)
      (Matrix.SpecialLinearGroup.mapGL ℝ γ)
    simp only [g]
    rw [ModularForm.SL_slash]
    exact this.continuous
  have hrc : Continuous r := hgc.div (continuous_etaPow N) (etaPow_ne_zero N)
  have hfin : {z : ℂ | z ^ N = 1}.Finite :=
    (Polynomial.nthRoots N (1 : ℂ)).toFinset.finite_toSet.subset fun z hz ↦ by
      simpa [Polynomial.mem_nthRoots (pos_of_mem hN)] using hz
  have hconst : ∀ τ τ', r τ = r τ' := fun τ τ' ↦
    isPreconnected_univ.constant_of_mapsTo hfin.isDiscrete hrc.continuousOn
      (fun x _ ↦ hrN x) (Set.mem_univ τ) (Set.mem_univ τ')
  refine ⟨r UpperHalfPlane.I, hrN _, funext fun τ ↦ ?_⟩
  rw [Pi.smul_apply, smul_eq_mul, hconst UpperHalfPlane.I τ]
  simp only [r]
  rw [div_mul_cancel₀ _ (etaPow_ne_zero N τ)]

/-- `h_N` is periodic of period `N`: `h_N ∣[k_N] T^N = h_N`. -/
lemma etaPow_slash_T_pow {N : ℕ} (hN : N = 3 ∨ N = 4) (k : ℤ) :
    etaPow N ∣[k] (ModularGroup.T ^ (N : ℤ)) = etaPow N := by
  funext τ
  rw [ModularForm.slash_action_eq'_iff]
  have h10 : ((ModularGroup.T ^ (N : ℤ) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 0 = 0 := by
    rw [ModularGroup.coe_T_zpow]; simp
  have h11 : ((ModularGroup.T ^ (N : ℤ) : SL(2, ℤ)) : Matrix (Fin 2) (Fin 2) ℤ) 1 1 = 1 := by
    rw [ModularGroup.coe_T_zpow]; simp
  rw [h10, h11, etaPow_eq_cuspProd hN, etaPow_eq_cuspProd hN, ModularGroup.coe_T_zpow_smul_eq]
  push_cast
  rw [qParam_add_period (pos_of_mem hN)]
  simp

/-- The stabilizer of a function under the weight-`k` slash action of `SL(2, ℤ)`. -/
def slashStabilizer (k : ℤ) (f : ℍ → ℂ) : Subgroup SL(2, ℤ) where
  carrier := {A | f ∣[k] A = f}
  one_mem' := SlashAction.slash_one k f
  mul_mem' {a b} ha hb := by
    simp only [Set.mem_ofPred_eq] at ha hb ⊢
    rw [SlashAction.slash_mul, ha, hb]
  inv_mem' {a} ha := by
    simp only [Set.mem_ofPred_eq] at ha ⊢
    have := SlashAction.slash_mul k a a⁻¹ f
    rw [mul_inv_cancel, SlashAction.slash_one, ha] at this
    exact this.symm

/-- The conjugates `γ T^N γ⁻¹` fix `h_N` (manuscript: `χ(P) = 1` for parabolic `P ∈ Γ(N)`). -/
lemma etaPow_slash_conj {N : ℕ} (hN : N = 3 ∨ N = 4) (γ : SL(2, ℤ)) :
    etaPow N ∣[((12 / N : ℕ) : ℤ)] (γ * ModularGroup.T ^ (N : ℤ) * γ⁻¹) = etaPow N := by
  obtain ⟨c, -, hc⟩ := exists_slash_eq_smul hN γ
  have hg : (etaPow N ∣[((12 / N : ℕ) : ℤ)] γ) ∣[((12 / N : ℕ) : ℤ)]
      (ModularGroup.T ^ (N : ℤ)) = etaPow N ∣[((12 / N : ℕ) : ℤ)] γ := by
    rw [hc, ModularForm.SL_smul_slash, etaPow_slash_T_pow hN]
  rw [SlashAction.slash_mul, SlashAction.slash_mul, hg, ← SlashAction.slash_mul, mul_inv_cancel,
    SlashAction.slash_one]

lemma Gamma_le_slashStabilizer {N : ℕ} (hN : N = 3 ∨ N = 4) :
    Gamma N ≤ slashStabilizer ((12 / N : ℕ) : ℤ) (etaPow N) := by
  refine (Gamma_le_normalClosure_T_pow N hN).trans ?_
  rw [Subgroup.normalClosure, Subgroup.closure_le]
  intro x hx
  obtain ⟨a, ha, hax⟩ := Group.mem_conjugatesOfSet_iff.mp hx
  rw [Set.mem_singleton_iff] at ha
  subst ha
  obtain ⟨γ, rfl⟩ := isConj_iff.mp hax
  exact etaPow_slash_conj hN γ

lemma etaPow_slash_of_mem {N : ℕ} (hN : N = 3 ∨ N = 4) {γ : SL(2, ℤ)} (hγ : γ ∈ Gamma N) :
    etaPow N ∣[((12 / N : ℕ) : ℤ)] γ = etaPow N :=
  Gamma_le_slashStabilizer hN hγ

/-! ### The modular form -/

/-- `h_N = η^{24/N}` as a slash-invariant form of weight `12 / N` on `Γ(N)`. -/
noncomputable def etaPowerSIF (N : ℕ) (hN : N = 3 ∨ N = 4) :
    SlashInvariantForm (Gamma N) ((12 / N : ℕ) : ℤ) where
  toFun := etaPow N
  slash_action_eq' γ hγ := by
    obtain ⟨g, hg, rfl⟩ := Subgroup.mem_map.mp hγ
    have := etaPow_slash_of_mem hN hg
    rw [ModularForm.SL_slash] at this
    exact this

/-- **Proposition 4.5(a)**: for `N ∈ {3, 4}`, `h_N = η^{24/N}` is a modular form of weight
`k_N = 12 / N` on `Γ(N)`. -/
noncomputable def etaPowerForm (N : ℕ) (hN : N = 3 ∨ N = 4) :
    ModularForm (Gamma N) ((12 / N : ℕ) : ℤ) where
  toSlashInvariantForm := etaPowerSIF N hN
  holo' := mdifferentiable_etaPow N
  bdd_at_cusps' {c} hc := by
    rw [OnePoint.isBoundedAt_iff_forall_SL2Z (hc.mono (Subgroup.map_le_range _ _))]
    intro γ _
    obtain ⟨ζ, -, hζ⟩ := exists_slash_eq_smul hN γ
    change IsBoundedAtImInfty (etaPow N ∣[((12 / N : ℕ) : ℤ)] γ)
    rw [hζ]
    apply IsZeroAtImInfty.isBoundedAtImInfty
    have := (tendsto_etaPow hN).const_mul ζ
    rw [mul_zero] at this
    exact this

lemma coe_etaPowerForm (N : ℕ) (hN : N = 3 ∨ N = 4) : ⇑(etaPowerForm N hN) = etaPow N :=
  (rfl)

lemma etaPowerForm_apply (N : ℕ) (hN : N = 3 ∨ N = 4) (τ : ℍ) :
    etaPowerForm N hN τ = η τ ^ (24 / N) :=
  congrFun (coe_etaPowerForm N hN) τ

/-- `h_N ^ N = Δ`. -/
theorem etaPowerForm_pow_apply (N : ℕ) (hN : N = 3 ∨ N = 4) (τ : ℍ) :
    etaPowerForm N hN τ ^ N = ModularForm.discriminant τ :=
  etaPow_pow hN τ

/-- `h₃ = η⁸ ∈ M₄(Γ(3))`. -/
noncomputable def etaPowerThree : ModularForm (Gamma 3) 4 :=
  etaPowerForm 3 (Or.inl rfl)

/-- `h₄ = η⁶ ∈ M₃(Γ(4))`. -/
noncomputable def etaPowerFour : ModularForm (Gamma 4) 3 :=
  etaPowerForm 4 (Or.inr rfl)

lemma etaPowerThree_apply (τ : ℍ) : etaPowerThree τ = η τ ^ 8 := (rfl)

lemma etaPowerFour_apply (τ : ℍ) : etaPowerFour τ = η τ ^ 6 := (rfl)

theorem etaPowerThree_pow_apply (τ : ℍ) : etaPowerThree τ ^ 3 = ModularForm.discriminant τ :=
  etaPowerForm_pow_apply 3 (Or.inl rfl) τ

theorem etaPowerFour_pow_apply (τ : ℍ) : etaPowerFour τ ^ 4 = ModularForm.discriminant τ :=
  etaPowerForm_pow_apply 4 (Or.inr rfl) τ

/-! ### The integral `q`-expansion -/

/-- The partial products `P_M = X (∏_{n < M} (1 - X^{N(n+1)}))^{24/N} ∈ ℤ[X]`. -/
noncomputable def truncPoly (N M : ℕ) : ℤ[X] :=
  X * (∏ n ∈ Finset.range M, (1 - X ^ (N * (n + 1)))) ^ (24 / N)

lemma truncPoly_succ (N M : ℕ) :
    truncPoly N (M + 1) = truncPoly N M * (1 - X ^ (N * (M + 1))) ^ (24 / N) := by
  rw [truncPoly, truncPoly, Finset.prod_range_succ, mul_pow, mul_assoc]

lemma coeff_truncPoly_succ {N : ℕ} (hN : 0 < N) {M m : ℕ} (hm : m ≤ M) :
    (truncPoly N (M + 1)).coeff m = (truncPoly N M).coeff m := by
  obtain ⟨Q, hQ⟩ : X ^ (N * (M + 1)) ∣ (1 - X ^ (N * (M + 1)) : ℤ[X]) ^ (24 / N) - 1 := by
    have := sub_dvd_pow_sub_pow (1 - X ^ (N * (M + 1)) : ℤ[X]) 1 (24 / N)
    rwa [one_pow, sub_sub_cancel_left, neg_dvd] at this
  have h : truncPoly N (M + 1) = truncPoly N M + X ^ (N * (M + 1)) * (truncPoly N M * Q) := by
    rw [truncPoly_succ, ← sub_add_cancel ((1 - X ^ (N * (M + 1)) : ℤ[X]) ^ (24 / N)) 1, hQ]
    ring
  have hlt : ¬ N * (M + 1) ≤ m := by nlinarith
  rw [h, coeff_add, coeff_X_pow_mul']
  simp [hlt]

lemma coeff_truncPoly_of_le {N : ℕ} (hN : 0 < N) {m M : ℕ} (hm : m ≤ M) :
    (truncPoly N M).coeff m = (truncPoly N m).coeff m := by
  induction M, hm using Nat.le_induction with
  | base => rfl
  | succ M hmM ih => rw [coeff_truncPoly_succ hN hmM, ih]

/-- The integral power series `X ∏_{n ≥ 1} (1 - X^{N n})^{24 / N} ∈ ℤ⟦X⟧`, defined through its
truncations: its coefficient of `X^m` is that of the partial product `truncPoly N M` for any
`M ≥ m` (`EtaPower.coeff_qSeries`). -/
noncomputable def qSeries (N : ℕ) : PowerSeries ℤ :=
  PowerSeries.mk fun m ↦ (truncPoly N m).coeff m

lemma coeff_qSeries {N : ℕ} (hN : 0 < N) {m M : ℕ} (hm : m ≤ M) :
    (qSeries N).coeff m = (truncPoly N M).coeff m := by
  rw [qSeries, PowerSeries.coeff_mk, coeff_truncPoly_of_le hN hm]

lemma coeff_zero_qSeries (N : ℕ) : (qSeries N).coeff 0 = 0 := by
  simp [qSeries, truncPoly]

lemma coeff_one_qSeries {N : ℕ} (hN : 0 < N) : (qSeries N).coeff 1 = 1 := by
  rw [qSeries, PowerSeries.coeff_mk, truncPoly, show (1 : ℕ) = 0 + 1 from rfl, coeff_X_mul,
    coeff_zero_eq_eval_zero]
  simp [hN.ne']

lemma eval_truncPoly (N M : ℕ) (q : ℂ) :
    ((truncPoly N M).map (Int.castRingHom ℂ)).eval q =
      q * (∏ n ∈ Finset.range M, (1 - (q ^ N) ^ (n + 1))) ^ (24 / N) := by
  simp [truncPoly, Polynomial.map_prod, Polynomial.eval_prod, pow_mul]

lemma tendstoLocallyUniformlyOn_const_seq {f : ℂ → ℂ} {s : Set ℂ} :
    TendstoLocallyUniformlyOn (fun _ : ℕ ↦ f) f atTop s := by
  rw [Metric.tendstoLocallyUniformlyOn_iff]
  intro ε hε x _
  exact ⟨s, self_mem_nhdsWithin, Eventually.of_forall fun _ y _ ↦ by simpa using hε⟩

/-- The partial products converge locally uniformly to `F_N` on the unit disc. -/
lemma tendstoLocallyUniformlyOn_truncPoly {N : ℕ} (hN : 0 < N) :
    TendstoLocallyUniformlyOn (fun M q ↦ ((truncPoly N M).map (Int.castRingHom ℂ)).eval q)
      (cuspProd N) atTop (Metric.ball 0 1) := by
  have h1 : TendstoLocallyUniformlyOn (fun M x ↦ ∏ n ∈ Finset.range M, (1 - x ^ (n + 1)))
      etaProd atTop (Metric.ball 0 1) :=
    multipliableLocallyUniformlyOn_one_sub_pow.hasProdLocallyUniformlyOn
      |>.tendstoLocallyUniformlyOn_finsetRange
  have h2 := h1.comp (fun q : ℂ ↦ q ^ N) (mapsTo_pow_ball hN) (continuous_pow N).continuousOn
  have hc : ContinuousOn (fun q : ℂ ↦ etaProd (q ^ N)) (Metric.ball 0 1) :=
    (differentiableOn_etaProd.comp (differentiableOn_pow N) (mapsTo_pow_ball hN)).continuousOn
  have h3 : ∀ j : ℕ, TendstoLocallyUniformlyOn
      (fun M q ↦ (∏ n ∈ Finset.range M, (1 - (q ^ N) ^ (n + 1))) ^ j)
      (fun q ↦ etaProd (q ^ N) ^ j) atTop (Metric.ball 0 1) := by
    intro j
    induction j with
    | zero =>
      simp only [pow_zero]
      exact tendstoLocallyUniformlyOn_const_seq
    | succ j ih =>
      have := ih.mul₀ h2 (hc.pow j) hc
      simp only [pow_succ]
      exact this
  have := (tendstoLocallyUniformlyOn_const_seq (f := fun q : ℂ ↦ q)).mul₀ (h3 (24 / N))
    continuousOn_id (hc.pow _)
  refine this.congr fun M q _ ↦ ?_
  simp [eval_truncPoly]

lemma tendstoLocallyUniformlyOn_iterate_derivative {U : Set ℂ} (hU : IsOpen U)
    {P : ℕ → ℂ[X]} {f : ℂ → ℂ}
    (h : TendstoLocallyUniformlyOn (fun M q ↦ (P M).eval q) f atTop U) (m : ℕ) :
    TendstoLocallyUniformlyOn (fun M q ↦ (derivative^[m] (P M)).eval q) (iteratedDeriv m f)
      atTop U := by
  induction m with
  | zero => simpa using h
  | succ m ih =>
    have := ih.deriv (Eventually.of_forall fun M ↦ (Polynomial.differentiable _).differentiableOn)
      hU
    rw [iteratedDeriv_succ]
    refine this.congr fun M q _ ↦ ?_
    simp only [Function.comp_apply, Function.iterate_succ_apply', Polynomial.deriv]

lemma eval_zero_iterate_derivative (p : ℂ[X]) (m : ℕ) :
    (derivative^[m] p).eval 0 = m.factorial * p.coeff m := by
  rw [← coeff_zero_eq_eval_zero, coeff_iterate_derivative, zero_add, Nat.descFactorial_self,
    nsmul_eq_mul]

/-- The Taylor coefficients of `F_N` at `0` are the coefficients of `qSeries N`. -/
lemma iteratedDeriv_cuspProd {N : ℕ} (hN : 0 < N) (m : ℕ) :
    iteratedDeriv m (cuspProd N) 0 = m.factorial * ((qSeries N).coeff m : ℂ) := by
  have h := (tendstoLocallyUniformlyOn_iterate_derivative Metric.isOpen_ball
    (tendstoLocallyUniformlyOn_truncPoly hN) m).tendsto_at (Metric.mem_ball_self one_pos)
  refine tendsto_nhds_unique h (tendsto_const_nhds.congr' (EventuallyEq.symm ?_))
  filter_upwards [eventually_ge_atTop m] with M hM
  rw [eval_zero_iterate_derivative, coeff_map, coeff_qSeries hN hM]
  simp

/-- The cusp function of `h_N` (in the variable `q^{1/N}`) is `F_N` on the unit disc. -/
lemma cuspFunction_etaPowerForm_eqOn {N : ℕ} (hN : N = 3 ∨ N = 4) :
    Set.EqOn (cuspFunction N (etaPowerForm N hN)) (cuspProd N) (Metric.ball 0 1) := by
  have hN0 : (0 : ℝ) < N := by exact_mod_cast pos_of_mem hN
  have hper : Function.Periodic (⇑(etaPowerForm N hN) ∘ ofComplex) (N : ℝ) :=
    SlashInvariantFormClass.periodic_comp_ofComplex _
      (by rw [strictPeriods_Gamma]; exact AddSubgroup.mem_zmultiples _)
  intro q hq
  rcases eq_or_ne q 0 with rfl | hq0
  · rw [coe_etaPowerForm, IsZeroAtImInfty.cuspFunction_apply_zero (tendsto_etaPow hN) hN0]
    simp [cuspProd]
  · have hq1 : ‖q‖ < 1 := by simpa using hq
    let τ : ℍ := ⟨Function.Periodic.invQParam N q,
      Function.Periodic.im_invQParam_pos_of_norm_lt_one hN0 hq1 hq0⟩
    have hτ : 𝕢 N τ = q := Function.Periodic.qParam_right_inv hN0.ne' hq0
    rw [← hτ, eq_cuspFunction τ hN0.ne' hper, coe_etaPowerForm, etaPow_eq_cuspProd hN]

/-- **Integral `q`-expansion** of `h_N` (Proposition 4.5(b), classical part): the expansion of
`h_N` in `q^{1/N}` is the image of `qSeries N = X ∏_{n ≥ 1} (1 - X^{N n})^{24 / N} ∈ ℤ⟦X⟧`. -/
theorem qExpansion_etaPowerForm (N : ℕ) (hN : N = 3 ∨ N = 4) :
    PowerSeries.map (Int.castRingHom ℂ) (qSeries N) = qExpansion N (etaPowerForm N hN) := by
  ext m
  rw [PowerSeries.coeff_map, qExpansion_coeff,
    ((cuspFunction_etaPowerForm_eqOn hN).eventuallyEq_of_mem
      (Metric.ball_mem_nhds 0 one_pos)).iteratedDeriv_eq, iteratedDeriv_cuspProd (pos_of_mem hN)]
  have : (m.factorial : ℂ) ≠ 0 := by exact_mod_cast m.factorial_ne_zero
  field_simp
  simp

/-- `h_N` has an integral `q`-expansion `G = X ∏_{n ≥ 1} (1 - X^{N n})^{24 / N}` in `q^{1/N}`:
`G ≡ truncPoly N M` modulo `X^{M+1}`, `G = X + O(X²)`. -/
theorem exists_integral_qExpansion (N : ℕ) (hN : N = 3 ∨ N = 4) :
    ∃ G : PowerSeries ℤ, PowerSeries.map (Int.castRingHom ℂ) G = qExpansion N (etaPowerForm N hN) ∧
      G.coeff 0 = 0 ∧ G.coeff 1 = 1 ∧ ∀ m M, m ≤ M → G.coeff m = (truncPoly N M).coeff m :=
  ⟨qSeries N, qExpansion_etaPowerForm N hN, coeff_zero_qSeries N,
    coeff_one_qSeries (pos_of_mem hN), fun _ _ h ↦ coeff_qSeries (pos_of_mem hN) h⟩

end EtaPower
