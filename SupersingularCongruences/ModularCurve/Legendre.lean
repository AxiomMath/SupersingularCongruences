module

public import SupersingularCongruences.ModularCurve.Gamma0Pair

/-!
# The Legendre family as pairs `(E, C)` with `C` of order `2`

For `λ ≠ 0, 1` the Legendre curve `E_λ : y² = x (x - 1) (x - λ)`, with the subgroup generated by
`P₁ = (0, 0)`, is a pair for `Γ₀(2)`. We use its short Weierstrass model, obtained by the
translation `x ↦ x + (1 + λ) / 3` (which preserves the differential `dx / (2y)`):

`y² = x³ + a₄(λ) x + a₆(λ)`, `a₄(λ) = -(λ² - λ + 1) / 3`,
`a₆(λ) = -(λ - 2) (λ + 1) (2 λ - 1) / 27`,

with `P₁ = (-(1 + λ) / 3, 0)`. Its discriminant is `16 λ² (λ - 1)²`.

## Main definitions

* `Gamma0.Pair.ofTwoTorsion`: the pair `(E, ⟨P⟩)` for a point `P = (e, 0)` of order `2` on a short
  Weierstrass elliptic curve.
* `Gamma0.legendreCurve λ`, `Gamma0.legendrePair λ`: the Legendre family.
-/

public section

open WeierstrassCurve WeierstrassCurve.Affine

namespace Gamma0

variable {L : Type*} [Field L]

/-- The short Weierstrass model `y² = x³ - (λ² - λ + 1) / 3 · x - (λ - 2) (λ + 1) (2 λ - 1) / 27` of
the Legendre curve `y² = x (x - 1) (x - λ)`. -/
noncomputable def legendreCurve (lam : L) : WeierstrassCurve L where
  a₁ := 0
  a₂ := 0
  a₃ := 0
  a₄ := -(lam ^ 2 - lam + 1) / 3
  a₆ := -((lam - 2) * (lam + 1) * (2 * lam - 1)) / 27

instance (lam : L) : (legendreCurve lam).IsShortNF := ⟨rfl, rfl, rfl⟩

lemma legendreCurve_Δ (h3 : (3 : L) ≠ 0) (lam : L) :
    (legendreCurve lam).Δ = 16 * lam ^ 2 * (lam - 1) ^ 2 := by
  have h27 : (27 : L) ≠ 0 := by
    have : (27 : L) = 3 ^ 3 := by norm_num
    rw [this]; exact pow_ne_zero _ h3
  rw [Δ_of_isShortNF]
  simp only [legendreCurve]
  field_simp
  ring

lemma isUnit_legendreCurve_Δ (h2 : (2 : L) ≠ 0) (h3 : (3 : L) ≠ 0) {lam : L} (h0 : lam ≠ 0)
    (h1 : lam ≠ 1) : IsUnit (legendreCurve lam).Δ := by
  rw [legendreCurve_Δ h3, isUnit_iff_ne_zero]
  have h16 : (16 : L) ≠ 0 := by
    have : (16 : L) = 2 ^ 4 := by norm_num
    rw [this]; exact pow_ne_zero _ h2
  exact mul_ne_zero (mul_ne_zero h16 (pow_ne_zero _ h0)) (pow_ne_zero _ (sub_ne_zero.mpr h1))

lemma legendreCurve_nonsingular (h2 : (2 : L) ≠ 0) (h3 : (3 : L) ≠ 0) {lam : L} (h0 : lam ≠ 0)
    (h1 : lam ≠ 1) : (legendreCurve lam).toAffine.Nonsingular (-(1 + lam) / 3) 0 := by
  have hΔ := isUnit_legendreCurve_Δ h2 h3 h0 h1
  have : (legendreCurve lam).IsElliptic := ⟨hΔ⟩
  have h27 : (27 : L) ≠ 0 := by
    have : (27 : L) = 3 ^ 3 := by norm_num
    rw [this]; exact pow_ne_zero _ h3
  refine (legendreCurve lam).toAffine.equation_iff_nonsingular.mp ?_
  rw [Affine.equation_iff]
  simp only [legendreCurve]
  field_simp
  ring

variable [DecidableEq L]

/-- The point `(e, 0)` of a short Weierstrass curve has order `2`. -/
lemma two_nsmul_some_zero (W : WeierstrassCurve L) [W.IsShortNF] {e : L}
    (he : W.toAffine.Nonsingular e 0) : 2 • Point.some e 0 he = 0 := by
  rw [two_nsmul]
  apply Point.add_of_Y_eq rfl
  simp [Affine.negY]

/-- The pair `(E, ⟨(e, 0)⟩)` for a short Weierstrass elliptic curve `E` and a point `(e, 0)`. -/
noncomputable def Pair.ofTwoTorsion (W : WeierstrassCurve L) [W.IsElliptic] [W.IsShortNF] (e : L)
    (he : W.toAffine.Nonsingular e 0) : Pair 2 L where
  curve := W
  subgroup := AddSubgroup.zmultiples (Point.some e 0 he)
  card_subgroup := by
    rw [Nat.card_zmultiples]
    exact addOrderOf_eq_prime (two_nsmul_some_zero W he) (Point.some_ne_zero he)

/-- The Legendre pair `(E_λ, ⟨(0, 0)⟩)` in short Weierstrass form, for `λ ≠ 0, 1` (and
`2, 3 ≠ 0` in `L`). -/
noncomputable def legendrePair (h2 : (2 : L) ≠ 0) (h3 : (3 : L) ≠ 0) {lam : L} (h0 : lam ≠ 0)
    (h1 : lam ≠ 1) : Pair 2 L :=
  have : (legendreCurve lam).IsElliptic := ⟨isUnit_legendreCurve_Δ h2 h3 h0 h1⟩
  Pair.ofTwoTorsion (legendreCurve lam) _ (legendreCurve_nonsingular h2 h3 h0 h1)

end Gamma0
